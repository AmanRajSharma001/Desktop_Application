{
  "name": "athena-exam",
  "productName": "Athena Exam",
  "private": true,
  "version": "1.0.0",
  "description": "Secure Proctored Desktop Examination Application",
  "author": "Aman Raj Sharma",
  "main": "./electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "server": "node backend/server.js",
    "dev": "vite",
    "build": "vite build",
    "dist": "npm run build && electron-builder --mac dmg --arm64",
    "dist:mac": "npm run build && electron-builder --mac dmg --arm64",
    "lint": "eslint .",
    "test": "node --test test/*.test.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "com.athena.exam",
    "productName": "Athena Exam",
    "copyright": "Copyright © 2026 Aman Raj Sharma",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "backend/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Athena Exam Installer",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    }
  }
}
